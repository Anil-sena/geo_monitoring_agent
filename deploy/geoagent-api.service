[Unit]
Description=GeoAgent Monitor (API + dashboard, single process)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=geoagent
Group=geoagent
WorkingDirectory=/opt/geoagent/backend
EnvironmentFile=/opt/geoagent/backend/.env
Environment=ENV=production
# gunicorn supervises uvicorn workers; each worker has its own pipeline thread pool.
# Keep workers low (1–2): Earth Engine work is I/O bound and memory per worker is high.
ExecStart=/opt/geoagent/backend/.venv/bin/gunicorn geoagent.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 900 \
    --graceful-timeout 60 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5
LimitNOFILE=65536
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/geoagent/backend/data /opt/geoagent/backend/models_store /opt/geoagent/backend/webui

[Install]
WantedBy=multi-user.target
