# ---- service ----
ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Only needed if you run `next dev` on a different port; the built UI is
# same-origin so CORS does not apply to it.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKERS=2

# ---- database ----
# sqlite (default, zero setup):
# DATABASE_URL=sqlite:///./data/geoagent.db
# postgres (production):
# DATABASE_URL=postgresql+psycopg://geoagent:change-me@127.0.0.1:5432/geoagent

# ---- earth engine ----
EE_PROJECT=your-gcp-project-id
# headless servers: use a service account instead of `earthengine authenticate`
# EE_SERVICE_ACCOUNT=geoagent@your-gcp-project-id.iam.gserviceaccount.com
# EE_PRIVATE_KEY_FILE=/etc/geoagent/ee-key.json
S2_CLOUD_PCT=60
S2_CLEAR_THRESHOLD=0.60
ALLOW_MOCK_IMAGERY_FALLBACK=false
ALLOW_SYNTHETIC_INFRASTRUCTURE=false
OSM_CACHE_TTL_SECONDS=3600

# ---- analysis ----
DEFAULT_CHANGE_THRESHOLD=0.35
DEFAULT_BUFFER_METERS=200
MIN_CHANGE_AREA_M2=400

# ---- llm (any one provider is enough) ----
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
